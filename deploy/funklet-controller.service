[Unit]
# Supervision for the Funklet light controller.
#
# Install with:
#   sudo cp deploy/funklet-controller.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now funklet-controller
#
# Then check on it with:
#   systemctl status funklet-controller
#   journalctl -u funklet-controller -f
#
# User=pi is correct for the current Funklet card, confirmed against the
# hardware. It is not an OS default -- Raspberry Pi OS has had no default "pi"
# user since April 2022 -- so if the card is ever rebuilt, check `whoami` and
# update User and WorkingDirectory here. systemd refuses to start the unit if the
# user does not exist, so a stale value fails loudly rather than silently.
# Confirm WorkingDirectory and ExecStart match this Pi's checkout and venv.
#
# Running under systemd also means stdout goes to the journal rather than an SSH
# pty, which removes a blocking-write path that could stall the event loop.
Description=Funklet LED light controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/funky_lights/controller
ExecStart=/usr/bin/python3 -u main.py
Environment=PYTHONUNBUFFERED=1

# main.py exits non-zero on an unhandled exception; bring it straight back.
Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
